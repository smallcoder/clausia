NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=        # server only (scripts, tests, LLM cost log)
GEMINI_API_KEY=             # server only. Clausia's OWN key (same Google account as LawMill, separate key so each project's spend shows on its own). Never copy it from ../lawmill/.env.
LLM_PROVIDER=gemini
LLM_CHAT_MODEL=gemini-3.8-flash
LLM_DOC_MODEL=gemini-3.5-flash-lite
LLM_DOC_FALLBACK_MODEL=gemini-3.8-flash
LLM_SPEND_CAP_USD=5
LAWMILL_SUPABASE_URL=                  # server only, read only (appeal deadlines read the article text from LawMill). Never NEXT_PUBLIC.
LAWMILL_SUPABASE_PUBLISHABLE_KEY=      # server only. The publishable key only; never a service key.
NEXT_PUBLIC_FEATURE_DEADLINES=         # 1 turns the appeal deadlines on (a lawyer must check the rules first; see README «Feature flags»)
