NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=        # server only (scripts, tests, LLM cost log)
GEMINI_API_KEY=             # server only. Clausia's OWN key (same Google account as LawMill, separate key so each project's spend shows on its own). Never copy it from ../lawmill/.env.
LLM_PROVIDER=gemini
LLM_CHAT_MODEL=gemini-3.8-flash
LLM_DOC_MODEL=gemini-3.5-flash-lite
